  "image_transform": {
    "description": "Extension convertURL(): derives display/thumbnail URLs from the raw CDN url using Qiniu imageView2.",
    "raw": "{rawSrc}",
    "display": "{rawSrc}?imageView2/2/w/{normalWidth}/{format}interlace/1",
    "thumbnail": "{rawSrc}?imageView2/2/w/{smallWidth}/{format}interlace/1",
    "smallWidth": "min(floor(203 * devicePixelRatio), 3840)",
    "normalWidth": "min(floor(screen.width * devicePixelRatio), 3840)",
    "format": "format/webp/ (empty on Safari)"
